# --- Général ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- Base de données ---
# Rôle applicatif (sans BYPASSRLS) : toutes les requêtes de l'API
DATABASE_URL=postgres://cir_app:cir_app@localhost:5432/cir_dev
# Rôle propriétaire : migrations uniquement
DATABASE_OWNER_URL=postgres://cir_owner:cir_owner@localhost:5432/cir_dev
# En développement, la migration donne ce mot de passe au rôle cir_app
DB_APP_PASSWORD=cir_app

# --- Sécurité ---
# Clé AES-256 (salaires, secrets MFA) : openssl rand -base64 32 — obligatoire en production
APP_ENCRYPTION_KEY=
SESSION_IDLE_HOURS=12
# MFA obligatoire pour administrateur et expert (laisser true hors poste de développement)
MFA_ENFORCED=true

# --- Stockage des fichiers (S3 compatible : Scaleway, OVHcloud) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# S3_BUCKET=cir-fichiers
# S3_ARCHIVE_BUCKET=cir-archives        # bucket avec Object Lock activé
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
ARCHIVE_RETENTION_YEARS=6

# --- Email transactionnel (Brevo, hébergement UE) ---
MAIL_DRIVER=log
# BREVO_API_KEY=
MAIL_FROM=Dossier CIR <no-reply@exemple.fr>

# --- Abonnement Stripe (désactivé si vide) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
TRIAL_DAYS=14
GRACE_DAYS=14

# --- SSO OpenID Connect (désactivé si vide) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=<identifiant du tenant>

# --- Antivirus (optionnel : docker compose --profile antivirus up) ---
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# Exécuter les tâches de fond (scellement, rappels) dans le processus API
RUN_WORKERS_IN_API=true
