{
  "name": "@cir/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "start:worker": "node dist/worker.js",
    "db:migrate:prod": "node dist/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@cir/shared": "*",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "openid-client": "^5.7.1",
    "otplib": "^12.0.1",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "stripe": "^18.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}